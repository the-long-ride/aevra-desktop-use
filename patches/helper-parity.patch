--- /dev/null
+++ b/helper/wayland/gnome/pixels.js
@@ -0,0 +1,41 @@
+import Gio from 'gi://Gio';
+import Shell from 'gi://Shell';
+import { frameCrop } from './policy.js';
+Gio._promisify(Shell.Screenshot, 'composite_to_stream');
+
+export async function capture(actor) {
+  const content = actor.paint_to_content(null);
+  const texture = content.get_texture();
+  const width = texture.get_width();
+  const height = texture.get_height();
+  if (width <= 0 || height <= 0 || width * height > 32 * 1024 * 1024)
+    throw Error('DESKTOP_INPUT_REFUSED');
+  const crop = frameCrop(
+    actor.meta_window.get_frame_rect(),
+    actor.meta_window.get_buffer_rect(),
+    width,
+    height,
+  );
+  const stream = Gio.MemoryOutputStream.new_resizable();
+  try {
+    await Shell.Screenshot.composite_to_stream(
+      texture,
+      crop.x,
+      crop.y,
+      crop.width,
+      crop.height,
+      1,
+      null,
+      0,
+      0,
+      1,
+      stream,
+    );
+    stream.close(null);
+    const bytes = stream.steal_as_bytes().get_data();
+    if (bytes.length > 128 * 1024 * 1024) throw Error('DESKTOP_INPUT_REFUSED');
+    return bytes;
+  } finally {
+    if (!stream.is_closed()) stream.close(null);
+  }
+}
diff --git a/helper/wayland/gnome/policy.js b/helper/wayland/gnome/policy.js
new file mode 100644
--- /dev/null
+++ b/helper/wayland/gnome/policy.js
@@ -0,0 +1,96 @@
+// Pure permission and target checks shared by the compositor and regression tests.
+export function eligibleHelper(path, peerUid, ownerUid) {
+  return (
+    typeof path === 'string' &&
+    path.startsWith('/') &&
+    peerUid === ownerUid &&
+    ['aevra-desktop-helper', 'aevra-desktop'].includes(path.split('/').pop())
+  );
+}
+export class Access {
+  constructor() {
+    this.enabled = false;
+    this.owners = new Set();
+  }
+  enable(value) {
+    this.enabled = value;
+    if (!value) this.owners.clear();
+  }
+  open(owner) {
+    if (!this.enabled) throw Error('DESKTOP_PERMISSION_REQUIRED');
+    this.owners.add(owner);
+  }
+  require(owner, locked) {
+    if (!this.enabled || locked || !this.owners.has(owner))
+      throw Error('DESKTOP_PERMISSION_REQUIRED');
+  }
+  close(owner) {
+    this.owners.delete(owner);
+  }
+  target(owner, locked, expected, actual) {
+    this.require(owner, locked);
+    if (!actual || actual.id !== expected.id || actual.pid !== expected.pid || !actual.focused)
+      throw Error('DESKTOP_TARGET_CHANGED');
+  }
+  point(window, x, y) {
+    const r = window.rect;
+    if (
+      !Number.isInteger(x) ||
+      !Number.isInteger(y) ||
+      x < r.x ||
+      y < r.y ||
+      x >= r.x + r.width ||
+      y >= r.y + r.height
+    )
+      throw Error('DESKTOP_INPUT_REFUSED');
+  }
+}
+
+// GNOME 46 returns the stage itself when no Shell actor owns keyboard focus.
+export function shellHasKeyFocus(focus, stage) {
+  return focus !== null && focus !== stage;
+}
+
+// MetaWindow focus does not imply keyboard ownership while Shell holds a grab.
+export function keyboardAllowed(state, text) {
+  return (
+    state.modalCount === 0 &&
+    !state.overview &&
+    !state.shellKeyFocus &&
+    state.normalMode &&
+    (!text || state.nativeTextFocus)
+  );
+}
+
+// Crop only this window actor; never substitute monitor pixels.
+export function frameCrop(frame, buffer, textureWidth, textureHeight) {
+  const positive = (r) =>
+    r && [r.x, r.y, r.width, r.height].every(Number.isFinite) && r.width > 0 && r.height > 0;
+  if (
+    !positive(frame) ||
+    !positive(buffer) ||
+    textureWidth <= 0 ||
+    textureHeight <= 0 ||
+    frame.x < buffer.x ||
+    frame.y < buffer.y ||
+    frame.x + frame.width > buffer.x + buffer.width ||
+    frame.y + frame.height > buffer.y + buffer.height
+  )
+    throw Error('DESKTOP_CAPTURE_UNSUPPORTED');
+  const sx = textureWidth / buffer.width,
+    sy = textureHeight / buffer.height;
+  const crop = {
+    x: Math.round((frame.x - buffer.x) * sx),
+    y: Math.round((frame.y - buffer.y) * sy),
+    width: Math.round(frame.width * sx),
+    height: Math.round(frame.height * sy),
+  };
+  if (
+    crop.width <= 0 ||
+    crop.height <= 0 ||
+    crop.x + crop.width > textureWidth ||
+    crop.y + crop.height > textureHeight
+  )
+    throw Error('DESKTOP_CAPTURE_UNSUPPORTED');
+  return crop;
+}
diff --git a/helper/wayland/gnome/policy.test.mjs b/helper/wayland/gnome/policy.test.mjs
new file mode 100644
--- /dev/null
+++ b/helper/wayland/gnome/policy.test.mjs
@@ -0,0 +1,91 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { Access, eligibleHelper, keyboardAllowed, frameCrop, shellHasKeyFocus } from './policy.js';
+
+test('only actual same-user Aevra helper paths can request compositor permission', () => {
+  assert.ok(eligibleHelper('/opt/aevra/aevra-desktop-helper', 1000, 1000));
+  assert.ok(eligibleHelper('/home/user/bin/aevra-desktop', 1000, 1000));
+  for (const path of [
+    '/usr/bin/gdbus',
+    'aevra-desktop-helper',
+    '/tmp/aevra-desktop-helper (deleted)',
+    '/tmp/not-aevra-desktop',
+  ])
+    assert.equal(eligibleHelper(path, 1000, 1000), false);
+  assert.equal(eligibleHelper('/opt/aevra/aevra-desktop-helper', 0, 1000), false);
+});
+
+test('disabled, locked and revoked connections never regain authority implicitly', () => {
+  const access = new Access();
+  assert.throws(() => access.open(':1.2'), /PERMISSION/);
+  access.enable(true);
+  access.open(':1.2');
+  access.require(':1.2', false);
+  assert.throws(() => access.require(':1.2', true), /PERMISSION/);
+  access.enable(false);
+  access.enable(true);
+  assert.throws(() => access.require(':1.2', false), /PERMISSION/);
+  access.open(':1.3');
+  access.close(':1.3');
+  assert.throws(() => access.require(':1.3', false), /PERMISSION/);
+});
+
+test('input requires exact target PID/focus and integer finite coordinates', () => {
+  const access = new Access();
+  access.enable(true);
+  access.open(':1.2');
+  const window = { id: 7, pid: 42, focused: true, rect: { x: -20, y: 0, width: 400, height: 200 } };
+  access.target(':1.2', false, { id: 7, pid: 42 }, window);
+  for (const changed of [
+    { ...window, id: 8 },
+    { ...window, pid: 43 },
+    { ...window, focused: false },
+  ])
+    assert.throws(
+      () => access.target(':1.2', false, { id: 7, pid: 42 }, changed),
+      /TARGET_CHANGED/,
+    );
+  assert.throws(() => access.point(window, NaN, 3), /INPUT_REFUSED/);
+  assert.throws(() => access.point(window, 380, 3), /INPUT_REFUSED/);
+  assert.throws(() => access.point(window, 2, 201), /INPUT_REFUSED/);
+  access.point(window, -20, 0);
+});
+
+test('keyboard effects refuse Shell ownership even while the app MetaWindow stays focused', () => {
+  const native = {
+    modalCount: 0,
+    overview: false,
+    shellKeyFocus: false,
+    normalMode: true,
+    nativeTextFocus: true,
+  };
+  assert.equal(keyboardAllowed(native, true), true);
+  for (const changed of [
+    { modalCount: 1 },
+    { overview: true },
+    { shellKeyFocus: true },
+    { normalMode: false },
+    { nativeTextFocus: false },
+  ])
+    assert.equal(keyboardAllowed({ ...native, ...changed }, true), false);
+  assert.equal(keyboardAllowed({ ...native, nativeTextFocus: false }, false), true);
+});
+
+test('window-only capture crops verified frame out of decorated buffer at native scale', () => {
+  const frame = { x: 440, y: 278, width: 400, height: 277 },
+    buffer = { x: 414, y: 255, width: 452, height: 329 };
+  assert.deepEqual(frameCrop(frame, buffer, 452, 329), { x: 26, y: 23, width: 400, height: 277 });
+  assert.deepEqual(frameCrop(frame, buffer, 904, 658), { x: 52, y: 46, width: 800, height: 554 });
+  const fractional = frameCrop(frame, buffer, 565, 411);
+  assert.equal(fractional.width, 500);
+  assert.equal(fractional.height, 346);
+  assert.throws(() => frameCrop({ ...frame, x: 0 }, buffer, 452, 329));
+});
+
+test('GNOME stage fallback is not Shell keyboard ownership', () => {
+  const stage = {};
+  assert.equal(shellHasKeyFocus(null, stage), false);
+  assert.equal(shellHasKeyFocus(stage, stage), false);
+  assert.equal(shellHasKeyFocus({}, stage), true);
+  assert.equal(shellHasKeyFocus(undefined, stage), true);
+});
