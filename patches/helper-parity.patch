+//! Native effects behind process-instance, focus, field and occlusion guards.
+use super::*;
+use crate::portable_contract::{bind_window, capture_scale, guard_point, Rect};
+use crate::{capture, portable_input, portable_pixels};
+#[path = "portable_binding.rs"]
+mod binding;
+#[path = "portable_focus.rs"]
+mod focus;
+
+pub(super) struct Snapshot {
+    pub instance: WindowInstance,
+    pub elements: HashMap<String, Element>,
+}
+fn bounds(element: &Element) -> Result<Rect, String> {
+    element
+        .bounds
+        .map(|r| Rect {
+            x: r.x,
+            y: r.y,
+            width: r.width,
+            height: r.height,
+        })
+        .filter(|r| r.width > 0 && r.height > 0)
+        .ok_or_else(|| "DESKTOP_INPUT_REFUSED: target has no visible bounds".into())
+}
+impl PortableBackend {
+    fn require_foreground(
+        &self,
+        instance: &WindowInstance,
+        native: u32,
+    ) -> Result<Element, String> {
+        let window = self.verify_instance(instance)?;
+        let focused = self.focused_window_element()?;
+        if window_id_for(&focused) != instance.window_id
+            || portable_pixels::focused()? != native
+            || self.bind_native(&window, instance)? != native
+        {
+            return Err("DESKTOP_TARGET_CHANGED: verified window is no longer foreground".into());
+        }
+        if self.identity(&window).executable_path.is_none() {
+            return Err("DESKTOP_INPUT_REFUSED: target executable is unattributable".into());
+        }
+        Ok(window)
+    }
+    fn fresh_elements(&self, window: &Element) -> Result<Vec<Element>, String> {
+        let mut queue = VecDeque::from([window.clone()]);
+        let mut elements = Vec::new();
+        while let Some(element) = queue.pop_front() {
+            if elements.len() >= 5000 {
+                return Err(
+                    "DESKTOP_INPUT_REFUSED: cannot verify focused field within bounded tree".into(),
+                );
+            }
+            queue.extend(element.children().map_err(map_a11y)?);
+            elements.push(element);
+        }
+        Ok(elements)
+    }
+    pub(super) fn capture_pixels(&self, request: CaptureRequest) -> Result<CaptureResult, String> {
+        portable_pixels::ensure_session()?;
+        crate::backend::verify_read_target(
+            self,
+            request.expected_target.as_ref(),
+            request.window_id.as_deref(),
+        )?;
+        let (frame, logical_width, identity) = if let Some(ref id) = request.window_id {
+            let window = self.resolve_window(id)?;
+            let instance = self.process_instance(&window)?;
+            let identity = self.identity(&window);
+            if identity.executable_path.is_none() {
+                return Err("DESKTOP_INPUT_REFUSED: capture target is unattributable".into());
+            }
+            let native = self.bind_native(&window, &instance)?;
+            let (frame, width) = portable_pixels::capture_window(native)?;
+            let after = self.verify_instance(&instance)?;
+            if self.bind_native(&after, &instance)? != native {
+                return Err("DESKTOP_TARGET_CHANGED: capture target changed".into());
+            }
+            (frame, width, Some(identity))
+        } else {
+            let (frame, width) = portable_pixels::capture_primary()?;
+            (frame, width, None)
+        };
+        crate::backend::verify_read_target(
+            self,
+            request.expected_target.as_ref(),
+            request.window_id.as_deref(),
+        )?;
+        let raw_width = frame.width;
+        let (image_data_uri, resize_ratio) = capture::encode_frame(frame)?;
+        Ok(CaptureResult {
+            image_data_uri,
+            device_pixel_ratio: capture_scale(raw_width, logical_width)? * resize_ratio,
+            window: identity,
+        })
+    }
+    pub(super) fn act_foreground(&self, mut request: ActRequest) -> Result<bool, String> {
+        let budget = crate::portable_contract::InputBudget::new();
+        portable_pixels::ensure_session()?;
+        let window = self.focused_window_element()?;
+        let instance = self.process_instance(&window)?;
+        let authorized = request.expected_target.as_ref();
+        crate::backend::require_authorized_target(
+            authorized,
+            &TargetIdentityResult {
+                window: self.identity(&window),
+                window_instance: instance.clone(),
+                host_application: None,
+            },
+        )?;
+        let native = self.bind_native(&window, &instance)?;
+        self.require_foreground(&instance, native)?;
+        #[cfg(target_os = "linux")]
+        if crate::wayland::active() {
+            crate::wayland::bind(native)?;
+        }
+        let provider = self.provider()?;
+        #[cfg(target_os = "linux")]
+        let app_data = if crate::wayland::active() {
+            provider.app_by_pid(instance.process_id)
+        } else {
+            provider.focused_app()
+        };
+        #[cfg(not(target_os = "linux"))]
+        let app_data = provider.focused_app();
+        let app = Element::new(app_data.map_err(map_a11y)?, provider);
+        if let Some(handle) = request.handle.take() {
+            let snapshots = self.foreground.borrow();
+            let snapshot = snapshots
+                .as_ref()
+                .ok_or("DESKTOP_REF_STALE: describe the foreground window first")?;
+            if snapshot.instance != instance {
+                return Err("DESKTOP_REF_STALE: foreground process instance changed".into());
+            }
+            let old = snapshot
+                .elements
+                .get(&handle)
+                .ok_or("DESKTOP_REF_STALE: unknown foreground handle")?;
+            let elements = self.fresh_elements(&window)?;
+            let fresh = elements
+                .iter()
+                .find(|e| {
+                    window_id_for(e) == window_id_for(old) && e.pid == old.pid && e.role == old.role
+                })
+                .ok_or("DESKTOP_REF_STALE: element no longer exists")?;
+            if !fresh.states.enabled || protected_field(fresh) {
+                return Err("DESKTOP_INPUT_REFUSED: disabled or protected element".into());
+            }
+            let r = bounds(fresh)?;
+            let x =
+                r.x.saturating_add((r.width / 2).min(i32::MAX as u32) as i32);
+            let y =
+                r.y.saturating_add((r.height / 2).min(i32::MAX as u32) as i32);
+            #[cfg(target_os = "linux")]
+            let (x, y) = if crate::wayland::active() {
+                let ax = bounds(&window)?;
+                let native = crate::wayland::window(native)?;
+                let native =
+                    crate::wayland_contract::accessibility_rect(&native, ax.width, ax.height)?;
+                (
+                    x.saturating_add(native.x.saturating_sub(ax.x)),
+                    y.saturating_add(native.y.saturating_sub(ax.y)),
+                )
+            } else {
+                (x, y)
+            };
+            request.x = Some(x);
+            request.y = Some(y);
+        }
+        // Discover the focused field once. Subsequent checks refresh only its
+        // parent/identity, refusing if focus moves rather than adopting a new field.
+        let field = if request.op == "type" || request.op == "key" {
+            Some(focus::focused_path(&window)?)
+        } else {
+            None
+        };
+        let guard = || {
+            budget.check()?;
+            let fresh = app
+                .children()
+                .map_err(map_a11y)?
+                .into_iter()
+                .find(|w| window_id_for(w) == instance.window_id)
+                .ok_or("DESKTOP_TARGET_CHANGED: authorized window no longer exists")?;
+            crate::backend::require_authorized_target(
+                authorized,
+                &TargetIdentityResult {
+                    window: self.identity(&fresh),
+                    window_instance: self.process_instance(&fresh)?,
+                    host_application: None,
+                },
+            )?;
+            self.require_native_owner(instance.process_id)?;
+            let current = portable_pixels::window(native)?;
+            let expected_rect = bounds(&fresh)?;
+            #[cfg(target_os = "linux")]
+            let expected_rect = if crate::wayland::active() {
+                crate::wayland_contract::accessibility_rect(
+                    &current,
+                    expected_rect.width,
+                    expected_rect.height,
+                )?;
+                current.rect
+            } else {
+                expected_rect
+            };
+            if portable_pixels::focused()? != native
+                || bind_window(instance.process_id, expected_rect, &[current])? != native
+            {
+                return Err(
+                    "DESKTOP_TARGET_CHANGED: authorized window is no longer foreground".into(),
+                );
+            }
+            if request.op == "type" || request.op == "key" {
+                focus::verify_field(&fresh, field.as_ref().expect("prepared focused field"))?;
+            }
+            if request.op == "scroll" {
+                let (x, y) = portable_input::pointer()?;
+                guard_point(expected_rect, x, y, native, portable_pixels::hit(x, y)?)?;
+            }
+            if request.op == "click" {
+                let (x, y) = request
+                    .x
+                    .zip(request.y)
+                    .ok_or("DESKTOP_INPUT_REFUSED: click requires coordinates or a live ref")?;
+                guard_point(expected_rect, x, y, native, portable_pixels::hit(x, y)?)?;
+            }
+            // AX reads can block; recheck focus and budget at the effect boundary.
+            if portable_pixels::focused()? != native {
+                return Err(
+                    "DESKTOP_TARGET_CHANGED: foreground changed during guard refresh".into(),
+                );
+            }
+            budget.check()
+        };
+        let result = portable_input::perform(&request, guard)?;
+        self.require_foreground(&instance,native).map_err(|_|"DESKTOP_OUTCOME_UNKNOWN: input completed but foreground target changed; observe again".to_string())?;
+        Ok(result)
+    }
+}
diff --git a/helper/src/portable_input.rs b/helper/src/portable_input.rs
new file mode 100644
--- /dev/null
+++ b/helper/src/portable_input.rs
@@ -0,0 +1,153 @@
+//! One native input transport, recreated per operation after permission/focus checks.
+use crate::backend::ActRequest;
+use crate::portable_action::prepare;
+use crate::portable_contract::{KeySink, TextSink};
+use enigo::{Axis, Button, Coordinate, Direction, Enigo, Key, Keyboard, Mouse, Settings};
+fn error(_: impl std::fmt::Display) -> String {
+    "DESKTOP_OUTCOME_UNKNOWN: native input was refused or interrupted; observe before sending further input".into()
+}
+fn open() -> Result<Enigo, String> {
+    crate::portable_pixels::ensure_session()?;
+    Enigo::new(&Settings{open_prompt_to_get_permissions:false,release_keys_when_dropped:true,..Settings::default()})
+        .map_err(|_|"DESKTOP_PERMISSION_REQUIRED: native input unavailable; grant Accessibility on macOS or check the X11/XTest session, then reconnect".into())
+}
+#[cfg(target_os = "linux")]
+pub fn pointer() -> Result<(i32, i32), String> {
+    if crate::wayland::active() {
+        return crate::wayland::pointer();
+    }
+    open()?.location().map_err(error)
+}
+#[cfg(target_os = "macos")]
+pub fn pointer() -> Result<(i32, i32), String> {
+    use core_graphics::{
+        event::CGEvent,
+        event_source::{CGEventSource, CGEventSourceStateID},
+    };
+    let source = CGEventSource::new(CGEventSourceStateID::CombinedSessionState)
+        .map_err(|_| "DESKTOP_INPUT_REFUSED: Quartz pointer source unavailable".to_string())?;
+    let event = CGEvent::new(source)
+        .map_err(|_| "DESKTOP_INPUT_REFUSED: Quartz pointer location unavailable".to_string())?;
+    let p = event.location();
+    // Quartz already uses the global top-left logical coordinate system. Do
+    // not flip with a physical display height (incorrect on Retina displays).
+    crate::portable_contract::logical_pointer(p.x, p.y)
+}
+pub fn ready() -> bool {
+    #[cfg(target_os = "linux")]
+    if crate::wayland::active() {
+        return crate::wayland::ready();
+    }
+    open().is_ok()
+}
+fn key(name: &str) -> Result<Key, String> {
+    Ok(match name {
+        "ctrl" => Key::Control,
+        "alt" => Key::Alt,
+        "shift" => Key::Shift,
+        "meta" => Key::Meta,
+        "enter" | "return" => Key::Return,
+        "escape" | "esc" => Key::Escape,
+        "tab" => Key::Tab,
+        "space" => Key::Space,
+        "backspace" => Key::Backspace,
+        "delete" | "del" => Key::Delete,
+        #[cfg(not(target_os = "macos"))]
+        "insert" => Key::Insert,
+        "up" => Key::UpArrow,
+        "down" => Key::DownArrow,
+        "left" => Key::LeftArrow,
+        "right" => Key::RightArrow,
+        "home" => Key::Home,
+        "end" => Key::End,
+        "pageup" => Key::PageUp,
+        "pagedown" => Key::PageDown,
+        "f1" => Key::F1,
+        "f2" => Key::F2,
+        "f3" => Key::F3,
+        "f4" => Key::F4,
+        "f5" => Key::F5,
+        "f6" => Key::F6,
+        "f7" => Key::F7,
+        "f8" => Key::F8,
+        "f9" => Key::F9,
+        "f10" => Key::F10,
+        "f11" => Key::F11,
+        "f12" => Key::F12,
+        "f13" => Key::F13,
+        "f14" => Key::F14,
+        "f15" => Key::F15,
+        "f16" => Key::F16,
+        "f17" => Key::F17,
+        "f18" => Key::F18,
+        "f19" => Key::F19,
+        "f20" => Key::F20,
+        #[cfg(not(target_os = "macos"))]
+        "f21" => Key::F21,
+        #[cfg(not(target_os = "macos"))]
+        "f22" => Key::F22,
+        #[cfg(not(target_os = "macos"))]
+        "f23" => Key::F23,
+        #[cfg(not(target_os = "macos"))]
+        "f24" => Key::F24,
+        _ if name.len() == 1 => Key::Unicode(name.chars().next().expect("validated key name")),
+        _ => {
+            return Err("DESKTOP_INPUT_REFUSED: key is unavailable on this operating system".into())
+        }
+    })
+}
+struct Sink(Enigo);
+impl KeySink for Sink {
+    type Key = Key;
+    fn key(&mut self, key: &Key, down: bool) -> Result<(), String> {
+        self.0
+            .key(
+                *key,
+                if down {
+                    Direction::Press
+                } else {
+                    Direction::Release
+                },
+            )
+            .map_err(error)
+    }
+}
+impl TextSink for Sink {
+    fn text(&mut self, text: &str) -> Result<(), String> {
+        self.0.text(text).map_err(error)
+    }
+}
+
+impl crate::input_executor::InputSink for Sink {
+    fn move_pointer(&mut self, x: i32, y: i32) -> Result<(), String> {
+        self.0.move_mouse(x, y, Coordinate::Abs).map_err(error)
+    }
+    fn button(&mut self, down: bool) -> Result<(), String> {
+        self.0
+            .button(
+                Button::Left,
+                if down {
+                    Direction::Press
+                } else {
+                    Direction::Release
+                },
+            )
+            .map_err(error)
+    }
+    fn scroll(&mut self, steps: i32) -> Result<(), String> {
+        self.0.scroll(steps, Axis::Vertical).map_err(error)
+    }
+}
+pub fn perform(
+    request: &ActRequest,
+    mut guard: impl FnMut() -> Result<(), String>,
+) -> Result<bool, String> {
+    #[cfg(target_os = "linux")]
+    if crate::wayland::active() {
+        return crate::wayland_input::perform(request, guard);
+    }
+    let action = prepare(request, key)?;
+    guard()?;
+    let mut sink = Sink(open()?);
+    crate::input_executor::execute(&mut sink, action, guard)
+}
diff --git a/helper/src/portable_macos.rs b/helper/src/portable_macos.rs
new file mode 100644
--- /dev/null
+++ b/helper/src/portable_macos.rs
@@ -0,0 +1,209 @@
+//! ScreenCaptureKit isolated-window streams. Never substitute a display crop.
+use crate::capture::Frame;
+use crate::portable_contract::{rgba_to_rgb, NativeWindow, Rect};
+use screencapturekit::cm::CMSampleBufferExt;
+use screencapturekit::cv::CVPixelBufferLockFlags;
+use screencapturekit::prelude::*;
+use std::sync::mpsc::{sync_channel, SyncSender};
+use std::time::Duration;
+
+#[link(name = "CoreGraphics", kind = "framework")]
+extern "C" {
+    fn CGPreflightScreenCaptureAccess() -> bool;
+}
+fn error(e: impl std::fmt::Display) -> String {
+    format!("DESKTOP_PROVIDER_UNAVAILABLE: ScreenCaptureKit: {e}")
+}
+pub fn ensure_session() -> Result<(), String> {
+    Ok(())
+}
+pub fn ready() -> bool {
+    // A capability probe must never itself open a consent prompt.
+    unsafe { CGPreflightScreenCaptureAccess() }
+}
+fn content() -> Result<SCShareableContent, String> {
+    if !ready() {
+        return Err("DESKTOP_PERMISSION_REQUIRED: enable Screen Recording for this binary in System Settings > Privacy & Security, then reconnect".into());
+    }
+    SCShareableContent::get().map_err(error)
+}
+pub fn windows() -> Result<Vec<NativeWindow>, String> {
+    let mut result = Vec::new();
+    for w in xcap::Window::all().map_err(error)? {
+        if w.is_minimized().map_err(error)? {
+            continue;
+        }
+        result.push(NativeWindow {
+            #[cfg(test)]
+            buffer: None,
+            id: w.id().map_err(error)?,
+            pid: w.pid().map_err(error)?,
+            rect: Rect {
+                x: w.x().map_err(error)?,
+                y: w.y().map_err(error)?,
+                width: w.width().map_err(error)?,
+                height: w.height().map_err(error)?,
+            },
+        });
+    }
+    Ok(result)
+}
+pub fn focused() -> Result<u32, String> {
+    let provider = xa11y::provider().map_err(error)?;
+    let app = provider.focused_app().map_err(error)?;
+    let ax = provider
+        .get_children(Some(&app))
+        .map_err(error)?
+        .into_iter()
+        .filter(|w| matches!(w.role, xa11y::Role::Window | xa11y::Role::Dialog))
+        .filter_map(|w| {
+            w.pid.zip(w.bounds).map(|(pid, r)| {
+                (
+                    pid,
+                    Rect {
+                        x: r.x,
+                        y: r.y,
+                        width: r.width,
+                        height: r.height,
+                    },
+                    w.states.active,
+                )
+            })
+        })
+        .collect::<Vec<_>>();
+    crate::portable_contract::bind_focused_window(&ax, &windows()?)
+}
+
+pub fn window(id: u32) -> Result<NativeWindow, String> {
+    windows()?
+        .into_iter()
+        .find(|w| w.id == id)
+        .ok_or("DESKTOP_TARGET_CHANGED: native window disappeared".into())
+}
+pub fn hit(x: i32, y: i32) -> Result<u32, String> {
+    use core_foundation::{
+        base::CFType, dictionary::CFDictionary, number::CFNumber, string::CFString,
+    };
+    use core_graphics::{geometry::CGRect, window::*};
+    // This list is deliberately UNFILTERED: sharing-disabled and unnamed windows
+    // must still block pointer input into any surface underneath them.
+    let ids = create_window_list(
+        kCGWindowListOptionOnScreenOnly | kCGWindowListExcludeDesktopElements,
+        0,
+    )
+    .ok_or("DESKTOP_INPUT_REFUSED: native surface list unavailable")?;
+    let descriptions = create_description_from_array(ids)
+        .ok_or("DESKTOP_INPUT_REFUSED: native surface metadata unavailable")?;
+    for entry in descriptions.iter() {
+        let dict: &CFDictionary<CFString, CFType> = &entry;
+        let value = dict
+            .find(CFString::new("kCGWindowBounds"))
+            .and_then(|v| v.downcast::<CFDictionary>())
+            .ok_or("DESKTOP_INPUT_REFUSED: an occluding surface has unverifiable bounds")?;
+        let r = CGRect::from_dict_representation(&value)
+            .ok_or("DESKTOP_INPUT_REFUSED: native surface bounds unavailable")?;
+        if f64::from(x) >= r.origin.x
+            && f64::from(y) >= r.origin.y
+            && f64::from(x) < r.origin.x + r.size.width
+            && f64::from(y) < r.origin.y + r.size.height
+        {
+            return dict
+                .find(CFString::new("kCGWindowNumber"))
+                .and_then(|v| v.downcast::<CFNumber>())
+                .and_then(|v| v.to_i64())
+                .and_then(|v| u32::try_from(v).ok())
+                .filter(|v| *v != 0)
+                .ok_or_else(|| {
+                    "DESKTOP_INPUT_REFUSED: top native surface has no verified identity".into()
+                });
+        }
+    }
+    Err("DESKTOP_INPUT_REFUSED: pointer has no verified native target".into())
+}
+struct OneFrame(SyncSender<Result<Frame, String>>);
+impl SCStreamOutputTrait for OneFrame {
+    fn did_output_sample_buffer(&self, sample: CMSampleBuffer, kind: SCStreamOutputType) {
+        if !matches!(kind, SCStreamOutputType::Screen) {
+            return;
+        }
+        let Some(buffer) = sample.pixel_buffer() else {
+            return;
+        };
+        let Ok(locked) = buffer.lock(CVPixelBufferLockFlags::READ_ONLY) else {
+            return;
+        };
+        // SAFETY: the CVPixelBuffer remains locked for the entire borrowed slice.
+        let Some(bytes) = (unsafe { locked.as_slice() }) else {
+            return;
+        };
+        let width = locked.width() as u32;
+        let height = locked.height() as u32;
+        let result = rgba_to_rgb(width, height, locked.bytes_per_row(), bytes, true)
+            .map(|rgb| Frame { width, height, rgb });
+        // Bounded channel: capture callbacks must never wait for the actor.
+        let _ = self.0.try_send(result);
+    }
+}
+fn grab(filter: SCContentFilter, width: u32, height: u32) -> Result<Frame, String> {
+    if width == 0 || height == 0 || u64::from(width) * u64::from(height) > 32 * 1024 * 1024 {
+        return Err("DESKTOP_PROVIDER_UNAVAILABLE: empty or oversized native capture".into());
+    }
+    let config = SCStreamConfiguration::new()
+        .with_width(width)
+        .with_height(height)
+        .with_pixel_format(PixelFormat::BGRA)
+        .with_shows_cursor(false)
+        .with_queue_depth(1);
+    let (tx, rx) = sync_channel(1);
+    let mut stream = SCStream::new(&filter, &config).map_err(error)?;
+    stream
+        .add_output_handler(OneFrame(tx), SCStreamOutputType::Screen)
+        .map_err(error)?;
+    stream.start_capture().map_err(error)?;
+    let frame = rx
+        .recv_timeout(Duration::from_secs(4))
+        .map_err(|_| "DESKTOP_PROVIDER_UNAVAILABLE: ScreenCaptureKit frame timed out".to_string())
+        .and_then(|v| v);
+    // Stop even after timeout/error; never leak an active capture session.
+    let stopped = stream.stop_capture().map_err(error);
+    stopped?;
+    frame
+}
+pub fn capture_window(id: u32) -> Result<(Frame, u32), String> {
+    let window = content()?
+        .windows()
+        .into_iter()
+        .find(|w| w.window_id() == id)
+        .ok_or_else(|| {
+            "DESKTOP_TARGET_CHANGED: native macOS window no longer exists".to_string()
+        })?;
+    let rect = window.frame();
+    let width = rect.size.width.round() as u32;
+    let height = rect.size.height.round() as u32;
+    let filter = SCContentFilter::create()
+        .with_window(&window)
+        .build()
+        .map_err(error)?;
+    grab(filter, width, height).map(|f| (f, width))
+}
+pub fn capture_primary() -> Result<(Frame, u32), String> {
+    let display = content()?
+        .displays()
+        .into_iter()
+        .find(|d| {
+            let r = d.frame();
+            r.origin.x == 0.0 && r.origin.y == 0.0
+        })
+        .ok_or_else(|| {
+            "DESKTOP_PROVIDER_UNAVAILABLE: no display at coordinate origin".to_string()
+        })?;
+    let logical_width = display.frame().size.width.round() as u32;
+    let width = display.width();
+    let height = display.height();
+    let filter = SCContentFilter::create()
+        .with_display(&display)
+        .with_excluding_windows(&[])
+        .build()
+        .map_err(error)?;
+    grab(filter, width, height).map(|f| (f, logical_width))
+}
diff --git a/helper/src/portable_session_tests.rs b/helper/src/portable_session_tests.rs
