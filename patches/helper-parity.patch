+def clicked(*_):
+    global clicks
+    clicks += 1
+
+button.connect("clicked", clicked)
+for child in [entry, password, button]:
+    box.pack_start(child, False, False, 0)
+window.add(box)
+window.connect("destroy", Gtk.main_quit)
+window.show_all()
+entry.grab_focus()
+window.present()
+
