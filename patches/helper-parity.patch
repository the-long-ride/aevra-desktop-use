diff --git a/helper/wayland/kde/policy.h b/helper/wayland/kde/policy.h
new file mode 100644
--- /dev/null
+++ b/helper/wayland/kde/policy.h
@@ -0,0 +1,54 @@
+#pragma once
+#include <QSet>
+#include <QString>
+#include <cmath>
+namespace Aevra {
+class Policy {
+  QString current, consumed;
+  QSet<QString> owners;
+
+public:
+  void grant(const QString &nonce) {
+    if (nonce.isEmpty()) {
+      revoke();
+      return;
+    }
+    if (nonce == consumed)
+      return;
+    if (nonce != current) {
+      owners.clear();
+      current = nonce;
+    }
+  }
+  void revoke() {
+    if (!current.isEmpty())
+      consumed = current;
+    current.clear();
+    owners.clear();
+  }
+  bool open(const QString &owner) {
+    if (current.isEmpty())
+      return false;
+    owners.insert(owner);
+    return true;
+  }
+  bool authorized(const QString &owner) const {
+    return !current.isEmpty() && owners.contains(owner);
+  }
+  void close(const QString &owner) { owners.remove(owner); }
+};
+inline bool validTarget(quint32 id, quint32 pid, bool focused,
+                        quint32 requestedId, quint32 requestedPid) {
+  return id && pid && focused && id == requestedId && pid == requestedPid;
+}
+inline bool validPoint(double x, double y, double width, double height,
+                       double px, double py) {
+  return std::isfinite(px) && std::isfinite(py) && width > 0 && height > 0 &&
+         px >= x && py >= y && px < x + width && py < y + height;
+}
+inline bool validMovePoint(double x, double y, double width, double height,
+                           double px, double py) {
+  return validPoint(x, y, width, height, px, py) && std::floor(px) == px &&
+         std::floor(py) == py;
+}
+} // namespace Aevra
diff --git a/helper/wayland/kde/policy_test.cpp b/helper/wayland/kde/policy_test.cpp
new file mode 100644
--- /dev/null
+++ b/helper/wayland/kde/policy_test.cpp
@@ -0,0 +1,47 @@
+#include "grant_store.h"
+#include "policy.h"
+#include <QtTest>
+class PolicyTest : public QObject {
+  Q_OBJECT
+private slots:
+  void grants() {
+    Aevra::Policy p;
+    QVERIFY(!p.authorized(":1.2"));
+    p.grant("first");
+    p.open(":1.2");
+    QVERIFY(p.authorized(":1.2"));
+    p.revoke();
+    QVERIFY(!p.authorized(":1.2"));
+    p.grant("first");
+    QVERIFY(!p.open(":1.2"));
+    p.grant("second");
+    QVERIFY(p.open(":1.2"));
+    p.close(":1.2");
+    QVERIFY(!p.authorized(":1.2"));
+  }
+  void restart() {
+    QTemporaryDir directory;
+    auto file = directory.filePath("accepted-grant");
+    Aevra::GrantStore first(file);
+    QVERIFY(first.accept("fresh-approval-nonce"));
+    Aevra::GrantStore restarted(file);
+    QVERIFY(!restarted.accept("fresh-approval-nonce"));
+    QVERIFY(restarted.accept("another-fresh-approval"));
+    QVERIFY(!restarted.accept("fresh-approval-nonce"));
+  }
+  void targets() {
+    QVERIFY(Aevra::validTarget(2, 10, true, 2, 10));
+    QVERIFY(!Aevra::validTarget(2, 10, false, 2, 10));
+    QVERIFY(!Aevra::validTarget(2, 10, true, 3, 10));
+    QVERIFY(!Aevra::validTarget(2, 10, true, 2, 11));
+    QVERIFY(!Aevra::validTarget(0, 10, true, 0, 10));
+    QVERIFY(Aevra::validPoint(100, 400, 400, 240, 110, 410));
+    QVERIFY(!Aevra::validPoint(100, 400, 400, 240, 500, 410));
+    QVERIFY(Aevra::validPoint(100, 400, 400, 240, 110.5, 410));
+    QVERIFY(!Aevra::validMovePoint(100, 400, 400, 240, 110.5, 410));
+    QVERIFY(Aevra::validMovePoint(100, 400, 400, 240, 110, 410));
+    QVERIFY(!Aevra::validPoint(100, 400, 400, 240, qQNaN(), 410));
+  }
+};
+QTEST_GUILESS_MAIN(PolicyTest)
+#include "policy_test.moc"
diff --git a/helper/wayland/package-companion.py b/helper/wayland/package-companion.py
new file mode 100644
--- /dev/null
+++ b/helper/wayland/package-companion.py
@@ -0,0 +1,36 @@
+"""Build the explicit-install GNOME companion; never install or enable it silently."""
+from pathlib import Path
+import sys
+import zipfile
+
+FILES = ("metadata.json", "extension.js", "policy.js", "pixels.js")
+def package(destination):
+    source = Path(__file__).resolve().parent / "gnome"
+    contents = {name: (source / name).read_bytes() for name in FILES}
+    destination.mkdir(parents=True, exist_ok=True)
+    target = destination / "aevra-desktop@the-long-ride.shell-extension.zip"
+    with zipfile.ZipFile(target, "w", compression=zipfile.ZIP_DEFLATED) as output:
+        for name, value in contents.items():
+            info = zipfile.ZipInfo(name, date_time=(2026, 10, 15, 0, 0, 0))
+            info.compress_type = zipfile.ZIP_DEFLATED
+            info.external_attr = 0o100644 << 16
+            output.writestr(info, value)
+    return target
+
+KDE_FILES = ("CMakeLists.txt", "metadata.json", "policy.h", "grant_store.h", "policy_test.cpp", "bridge.h", "bridge.cpp", "device.h", "device.cpp", "pixels.h", "pixels.cpp", "README.md")
+
+def package_kde(destination):
+    source = Path(__file__).resolve().parent / "kde"
+    destination.mkdir(parents=True, exist_ok=True)
+    target = destination / "aevra-wayland-kde-source.zip"
+    with zipfile.ZipFile(target, "w", compression=zipfile.ZIP_DEFLATED) as output:
+        for name in KDE_FILES:
+            info = zipfile.ZipInfo(name, date_time=(2026, 10, 15, 0, 0, 0))
+            info.compress_type = zipfile.ZIP_DEFLATED
+            info.external_attr = 0o100644 << 16
+            output.writestr(info, (source / name).read_bytes())
+    return target
+
+if __name__ == "__main__":
+    print(package(Path(sys.argv[1])))
+    print(package_kde(Path(sys.argv[1])))
