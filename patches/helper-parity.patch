+    fixture(json!({"op":"focus","pid":sentinel.0.id()}));
+    assert!(backend.act(action(json!({"op":"key","keys":"a"}))).is_err());
+    assert!(backend
+        .act(action(json!({"op":"type","text":"blocked"})))
